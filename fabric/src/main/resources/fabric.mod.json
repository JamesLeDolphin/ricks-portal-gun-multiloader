{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/JamesLeDolphin/mod-wikis/wiki/Rick's-Portal-Gun",
        "issues": "https://discord.com/invite/mPFZqXpcFF"
    },
    "license": "${license}",
    "icon": "rpg_fabric.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.jdolphin.ricksportalgun.RicksPortalGunFabricMain"
        ],
        "client": [
            "com.jdolphin.ricksportalgun.client.RicksPortalGunFabricClient"
        ],
        "jei_mod_plugin": [
            "com.jdolphin.ricksportalgun.common.comp.jei.PGJeiPlugin"
        ],
        "emi": [
            "com.jdolphin.ricksportalgun.common.comp.emi.PGEmiPlugin"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "forgeconfigapiport": "*"
    },
    "suggests": {
        "emi": "*"
    }
}
  